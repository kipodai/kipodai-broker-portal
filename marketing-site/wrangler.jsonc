{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "kipodai-marketing-preview",
  "main": "worker.js",
  "compatibility_date": "2026-08-22",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}
