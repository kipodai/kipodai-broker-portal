# Copy to .env for local `netlify dev`. Never commit the real .env.

# Required
ADMIN_PASSWORD=
CLIENT_PASSWORD=
SESSION_SECRET=

# Optional — app must fully function with these unset
RESEND_API_KEY=
ANTHROPIC_API_KEY=

# Required if RESEND_API_KEY is set
EMAIL_FROM_ADDRESS=
# Comma-separated, pre-defined. The UI only lets the admin pick from this list — never free text.
CLIENT_EMAIL_RECIPIENTS=
