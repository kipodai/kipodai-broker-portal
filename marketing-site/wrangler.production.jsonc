{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "kipodai-marketing",
  "main": "worker.js",
  "compatibility_date": "2026-08-22",
  // The Worker runs first for every request so /demos/* cannot be reached via
  // an odd path encoding; anything that is not gated falls straight through to
  // the static assets. Secrets (set by hand, never in this file):
  //   DEMO_PASSWORD, DEMO_GATE_SECRET  (same DEMO_GATE_SECRET on the demo Worker)
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  // Legacy hosts (kipodai.com, www.kipodai.com) and www.spikeretail.com are
  // bound only so the Worker can 301 them to https://spikeretail.com.
  "routes": [
    { "pattern": "spikeretail.com", "custom_domain": true },
    { "pattern": "www.spikeretail.com", "custom_domain": true },
    { "pattern": "kipodai.com", "custom_domain": true },
    { "pattern": "www.kipodai.com", "custom_domain": true }
  ],
  "vars": {
    "COOKIE_DOMAIN": ".spikeretail.com"
  }
}
