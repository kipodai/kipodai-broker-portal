{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Renamed from "kipodai-site" (2026-08-21): that name belongs to the
  // separate marketing-site Worker (different repo) — Cloudflare Worker
  // names are unique per account, so keeping the same name here would have
  // deployed this broker-portal over the live marketing site. Named after
  // this app's real hostname (see below) since the multi-tenant direction
  // is one Worker deploy per client, not one shared deploy.
  "name": "shiftretailgroup-broker-portal",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-21",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  // Created 2026-08-21 via `wrangler kv namespace create REPORTS_KV`.
  // Every server/storage.js call and worker/routes/*.js handler reads this
  // exact binding name.
  "kv_namespaces": [
    { "binding": "REPORTS_KV", "id": "d9b77bfaf19f45769d015eae4fa2c21f" }
  ],
  // Bound 2026-08-22: shiftretailgroup.kipodai.com -> this Worker, via
  // wrangler-managed Custom Domain (NOT a manual CNAME to the workers.dev
  // hostname — that pattern 522s, confirmed during the earlier failover
  // investigation). custom_domain:true means `wrangler deploy` creates and
  // owns the DNS record itself. Only kipodai.com/www.kipodai.com are
  // excluded (separate marketing-site Worker, now its own project — see
  // DECISIONS.md). GitHub-Actions DNS failover to Netlify deferred until
  // the Netlify backup site's 401 ("private by default") is resolved —
  // a Custom Domain binding isn't a plain CNAME the failover script can
  // flip, so that script needs a redesign before it's wired back in.
  "routes": [
    { "pattern": "shiftretailgroup.kipodai.com", "custom_domain": true }
  ]
}
